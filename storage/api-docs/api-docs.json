{
    "openapi": "3.0.0",
    "info": {
        "title": "Product Catalogue API",
        "description": "A Sanctum-authenticated CRUD API. Issue a token at POST /api/auth/token, then paste it into Swagger UI's Authorize dialog.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/account": {
            "get": {
                "tags": [
                    "Account"
                ],
                "summary": "Fetch the current account",
                "description": "Display the authenticated account.",
                "operationId": "219860671bfa5f8b13e9fd9cae612836",
                "responses": {
                    "200": {
                        "description": "The authenticated account.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Account"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Account"
                ],
                "summary": "Register an account",
                "description": "Creates an account and returns a Sanctum token for it. Public and rate limited to 6 requests per minute.",
                "operationId": "2f6808d33992e5508d371ce7b0915f4f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Ada Lovelace",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "ada@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "correct-horse-battery",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "description": "Must match `password`.",
                                        "type": "string",
                                        "format": "password",
                                        "example": "correct-horse-battery",
                                        "minLength": 8
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The account was created and a token issued.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "description": "The new account.",
                                            "type": "object"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "3|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed, including an email that is already registered."
                    }
                },
                "security": []
            },
            "delete": {
                "tags": [
                    "Account"
                ],
                "summary": "Delete the current account",
                "description": "Delete the authenticated account.",
                "operationId": "0c8108075ba0561b36fd40d4bd55c65b",
                "responses": {
                    "204": {
                        "description": "Deleted."
                    },
                    "401": {
                        "description": "Unauthenticated."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "patch": {
                "tags": [
                    "Account"
                ],
                "summary": "Update the current account",
                "description": "Partial update: any field left out of the body is left unchanged. Changing the password requires `current_password` and revokes all other tokens.",
                "operationId": "6cd08ac42bfa10c9ac0a437a9992ca13",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Ada Lovelace",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "ada@newdomain.test"
                                    },
                                    "current_password": {
                                        "description": "Required, and must match, whenever `password` is present. Ignored otherwise.",
                                        "type": "string",
                                        "format": "password",
                                        "example": "correct-horse-battery"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "new-correct-horse",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "description": "Must match `password`.",
                                        "type": "string",
                                        "format": "password",
                                        "example": "new-correct-horse",
                                        "minLength": 8
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The updated account.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Account"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated."
                    },
                    "422": {
                        "description": "Validation failed, including an email that is already taken or a `current_password` that does not match."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "List products",
                "description": "Display a paginated listing of products.",
                "operationId": "d97d1c3727cbac49708b85f7d11f7d58",
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Items per page (max 100).",
                        "schema": {
                            "type": "integer",
                            "default": 15,
                            "maximum": 100,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number.",
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of products.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Product"
                                            }
                                        },
                                        "links": {
                                            "description": "Laravel pagination links.",
                                            "type": "object"
                                        },
                                        "meta": {
                                            "description": "Laravel pagination metadata.",
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Products"
                ],
                "summary": "Create a product",
                "description": "Store a newly created product.",
                "operationId": "785644b7d7dd38af4b51dafd0fbc1b6d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Product"
                            },
                            "example": {
                                "name": "Mechanical Keyboard",
                                "description": "Hot-swappable 75% board.",
                                "price": 129.99,
                                "stock": 42
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The created product.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated."
                    },
                    "422": {
                        "description": "Validation failed."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/products/{product}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Fetch a product",
                "description": "Display the specified product.",
                "operationId": "db00b523e69d5dbc09c6edad76374bdc",
                "parameters": [
                    {
                        "name": "product",
                        "in": "path",
                        "description": "Product ID.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The product.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found."
                    },
                    "401": {
                        "description": "Unauthenticated."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Products"
                ],
                "summary": "Delete a product",
                "description": "Remove the specified product.",
                "operationId": "ac878db81fdb1333b21fc79e574a5a17",
                "parameters": [
                    {
                        "name": "product",
                        "in": "path",
                        "description": "Product ID.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Deleted."
                    },
                    "404": {
                        "description": "Product not found."
                    },
                    "401": {
                        "description": "Unauthenticated."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "patch": {
                "tags": [
                    "Products"
                ],
                "summary": "Update a product",
                "description": "Partial update: any field left out of the body is left unchanged.",
                "operationId": "77823cadb36f3d38bb51cc6e7cf6514a",
                "parameters": [
                    {
                        "name": "product",
                        "in": "path",
                        "description": "Product ID.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Product"
                            },
                            "example": {
                                "stock": 17
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The updated product.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Product not found."
                    },
                    "401": {
                        "description": "Unauthenticated."
                    },
                    "422": {
                        "description": "Validation failed."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/token": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Issue an API token",
                "description": "Returns a Sanctum personal access token to be sent as `Authorization: Bearer <token>`.",
                "operationId": "61ea4d4630ebe11ea63a98088937f323",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "test@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The issued token and the authenticated user.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "example": "3|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                                        },
                                        "user": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "format": "email"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid credentials."
                    }
                },
                "security": []
            },
            "delete": {
                "tags": [
                    "Auth"
                ],
                "summary": "Revoke the current token",
                "description": "Revoke the token that authenticated the current request.",
                "operationId": "7aced94c57481d64e642dd1dd3fc3a13",
                "responses": {
                    "204": {
                        "description": "Revoked."
                    },
                    "401": {
                        "description": "Unauthenticated."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "Account": {
                "required": [
                    "id",
                    "name",
                    "email",
                    "created_at",
                    "updated_at"
                ],
                "properties": {
                    "id": {
                        "description": "Also the `Account` component schema. Credentials are deliberately absent:\nthey are write-only inputs and must never appear in a response.",
                        "type": "integer",
                        "readOnly": true,
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Test User",
                        "maxLength": 255
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "test@example.com",
                        "maxLength": 255
                    },
                    "email_verified_at": {
                        "description": "Always null: this API never sends verification mail.",
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true,
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "type": "object"
            },
            "Product": {
                "required": [
                    "id",
                    "name",
                    "price",
                    "stock",
                    "created_at",
                    "updated_at"
                ],
                "properties": {
                    "id": {
                        "description": "Also the `Product` component schema: the same definition backs both the\nrequest bodies and the responses, so `readOnly` fields (id, timestamps) are\nhidden by Swagger UI when composing a create or update body.",
                        "type": "integer",
                        "readOnly": true,
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Mechanical Keyboard",
                        "maxLength": 255
                    },
                    "description": {
                        "type": "string",
                        "example": "Hot-swappable 75% board.",
                        "nullable": true
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 129.99,
                        "minimum": 0
                    },
                    "stock": {
                        "type": "integer",
                        "example": 42,
                        "minimum": 0
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Paste the token returned by POST /api/auth/token.",
                "bearerFormat": "Sanctum personal access token",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Account",
            "description": "Registration and self-service management of the authenticated account."
        },
        {
            "name": "Products",
            "description": "CRUD operations on the product catalogue."
        },
        {
            "name": "Auth",
            "description": "Issue and revoke the Sanctum token used by the other endpoints."
        }
    ]
}