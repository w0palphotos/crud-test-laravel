:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    # Vite fingerprints its output filenames, so these are safe to cache
    # indefinitely.
    @assets path /build/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # try_files takes a path relative to root. An absolute /index.php would be
    # resolved against the filesystem root instead of /app/public, and every
    # non-file route would 502.
    php_server {
        try_files {path} index.php
    }
}
