APP_NAME=Laravel
APP_ENV=local
# Generate a real one with: php artisan key:generate
APP_KEY=your-app-key-here
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
# Indonesian as its own fallback. A missing Indonesian string then shows as its
# key rather than silently falling back to English in a form nobody can read.
APP_FALLBACK_LOCALE=id
# Faker is fixture data for tests and seeds, not interface copy, so this stays
# English and does not affect what a person sees.
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite, so there are no credentials below. This file is
# a *local* template: do not paste it into Vercel or any other host. Doing so
# ships DB_CONNECTION=sqlite with no host or password, and the application
# silently falls back to a local database file that does not exist there. Every
# cache-backed route then fails, including GET /docs, because its rate limiter
# reads the cache table before the route runs. Set DB_URL on the host instead;
# see docs/10-deploying.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Login kedaluwarsa setelah satu hari idle. Ini batas idle sesi web, bukan
# janji kedaluwarsa absolut bila pengguna terus aktif.
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Token API kedaluwarsa setelah satu hari dan harus dibuat ulang dengan login ulang.
SANCTUM_TOKEN_EXPIRATION=1440

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# The chat bubble calls the Gemini API (Google AI Studio). Get a key at
# https://aistudio.google.com/apikey and set it here and on the host. Never prefix
# it with VITE_: anything VITE_ ships to the browser and this key bills real money.
# With no key the bubble returns a friendly "service unavailable" instead of failing.
GEMINI_API_KEY=

# Optional. The base URL of the Gemini API, NOT a full endpoint: the SDK appends
# the path it needs, so a value ending in :generateContent is asked for at
# "...:generateContent/interactions" and Google answers 404.
# GEMINI_URL=

# Optional. Which model answers. 2.5-flash is retired for newly created keys and
# returns 404, so this changes as models are retired.
GEMINI_MODEL=gemini-3.5-flash

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where uploaded images go. `public` is a local disk needing no credentials, which
# is what a fresh checkout and the test suite use. `s3` is Supabase Storage, which
# is what production needs: a container's local disk is ephemeral, so an image
# written into it is gone when the instance is recycled.
#
# With `public`, run `php artisan storage:link` so the files are served.
IMAGES_DISK=public
IMAGES_MAX_KILOBYTES=2048

# The documents filed with a sale: faktur, surat jalan, proof of delivery.
#
# A second bucket, and private. Privacy belongs to a bucket and not to a folder
# inside one, so a document cannot share a bucket with a photograph of a part.
# A link to a document is signed and expires, rather than being an address
# anybody can keep.
#
# DOCUMENTS_DISK names the disk in config/filesystems.php, not a bucket; the
# bucket is AWS_BUCKET_DOCUMENTS below.
DOCUMENTS_DISK=documents
DOCUMENTS_MAX_KILOBYTES=5120
DOCUMENTS_SIGNED_URL_MINUTES=15

# Supabase Storage over the S3 protocol. Only read when IMAGES_DISK=s3.
#
# Generate the keys at Project Settings -> Storage -> S3, and enable the S3
# protocol there first. The endpoint is the project's storage host with
# /storage/v1/s3 appended — not the main project host, which is slower for
# uploads.
#
# These bypass Row Level Security entirely: they are full access across every
# bucket. They are server credentials and must never reach a VITE_ variable, the
# built bundle, or any Inertia prop.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# The private bucket the documents filed with a sale go into. It must not be the
# same bucket as the images: one holds photographs that are the public's business,
# the other holds faktur and surat jalan.
AWS_BUCKET_DOCUMENTS=

# The PUBLIC url of the bucket, not the S3 endpoint above.
#
# Without it the disk falls back to the client's object url, which for Supabase is
# the API endpoint — and that needs authentication. An upload would then succeed
# and write an unopenable URL into a sale's note.
#
#   AWS_ENDPOINT  https://PROJECTREF.storage.supabase.co/storage/v1/s3
#   AWS_URL       https://PROJECTREF.supabase.co/storage/v1/object/public/BUCKET
AWS_URL=

# Importing sales from a document. MAX_KILOBYTES bounds the upload, MAX_ROWS bounds
# how many sales one document may become, and TEXT_LIMIT bounds the characters sent
# to the model when the document is read by AI rather than by the table parser. See
# config/imports.php for what each one protects.
IMPORTS_MAX_KILOBYTES=5120
IMPORTS_MAX_ROWS=200
IMPORTS_TEXT_LIMIT=20000

# Inertia server-side rendering. Left off deliberately: it needs a Node process
# answering on every request, and the runtime image built by Dockerfile.vercel is
# FrankenPHP. See config/inertia.php.
INERTIA_SSR_ENABLED=false

# Slack incoming webhook URL for reporting fatal runtime errors.
# Create webhook in Slack Workspace -> Incoming WebHooks, paste URL below.
LOG_SLACK_WEBHOOK_URL=

