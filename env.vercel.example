# Environment variables untuk deployment Vercel.
#
# BUKAN `.env` dan bukan `.env.production`. Pola `.env.*` ada di .gitignore, jadi
# file dengan awalan itu tidak akan pernah ikut ter-commit dan hilang begitu kamu
# pindah mesin. File ini yang sengaja tidak memakai awalan `.env` supaya bisa
# dibaca orang lain.
#
# Salin setiap baris ke Vercel → Settings → Environment Variables, Environment
# "Production". Jangan menyalin file ini apa adanya: isinya templat, dan setiap
# nilai di bawah yang ditulis <...> harus diisi dari akunmu sendiri.
#
# File kredensial aslimu bisa disimpan terpisah sebagai `.env.vercel` — itu
# ter-ignore git, jadi aman, tapi hilang saat ganti mesin. Dua-duanya berguna:
# yang ini untuk dibaca, yang itu untuk diisi.
#
# `.env.example` bukan pengganti file ini. Ia templat SQLite lokal, dan
# menyalinnya ke dasbor mengirim DB_CONNECTION=sqlite tanpa kredensial.
# docs/10-deploying.md menjelaskan gejalanya dan cara membacanya.

# ══ TABEL: SALIN DENGAN JENIS YANG TEPAT ═══════════════════════════════════
#
# Secret dan Config sampai ke PHP dengan cara yang PERSIS SAMA — jenis di Vercel
# tidak mengubah perilaku aplikasi. Yang berbeda hanya perlindungan: nilai Secret
# tidak muncul lagi di dasbor setelah disimpan, dan tidak bocor ke output
# `php artisan`. Pakai Secret untuk apa yang bocornya berbahaya, dan tidak ada
# biaya selain sedikit ketidaknyamanan saat debugging.
#
# JENIS      VARIABEL
# ─────────────────────────────────────────────────────────────────────────────
# Secret     APP_KEY
# Secret     DB_URL
# Secret     AWS_ACCESS_KEY_ID
# Secret     AWS_SECRET_ACCESS_KEY
# Secret     GEMINI_API_KEY
# Config     APP_NAME, APP_URL
# Config     APP_LOCALE, APP_FALLBACK_LOCALE, APP_FAKER_LOCALE
# Config     BCRYPT_ROUNDS
# Config     DB_CONNECTION
# Config     SESSION_DRIVER, SESSION_LIFETIME, SESSION_ENCRYPT, SESSION_PATH,
#            SESSION_DOMAIN, SANCTUM_TOKEN_EXPIRATION
# Config     CACHE_STORE, FILESYSTEM_DISK
# Config     IMAGES_DISK, IMAGES_MAX_KILOBYTES
# Config     AWS_DEFAULT_REGION, AWS_BUCKET, AWS_ENDPOINT, AWS_URL,
#            AWS_USE_PATH_STYLE_ENDPOINT
# Config     MAIL_MAILER, MAIL_FROM_ADDRESS, MAIL_FROM_NAME
# Config     IMPORTS_MAX_KILOBYTES, IMPORTS_MAX_ROWS, IMPORTS_TEXT_LIMIT
# Config     INERTIA_SSR_ENABLED
#
# AWS_DEFAULT_REGION sering ikut terkunci di dasbor. Itu tidak berbahaya, hanya
# berlebihan — region bukan rahasia. Melepasnya jadi Config memudahkan debugging.
#
# ══ APLIKASI ════════════════════════════════════════════════════════════════
# Buat dengan: php artisan key:generate --show
APP_KEY=<base64:...>
APP_NAME="Sales Desk"

# WAJIB sama dengan origin tempat aplikasi benar-benar diakses. route() membangun
# URL dari nilai ini, jadi setiap tautan yang server kirim ke browser ikut
# memakainya — termasuk endpoint unggah gambar dan tombol Simpan. Kalau berbeda,
# form mem-post ke origin yang salah, cookie sesi tidak ikut terkirim, dan
# pengunggahan berhenti dengan 419 tanpa penjelasan.
APP_URL=https://crud-test-laravel.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

# APP_ENV, APP_DEBUG, LOG_CHANNEL, dan QUEUE_CONNECTION sudah di-set sebagai ENV
# di Dockerfile.vercel, jadi tidak perlu di sini. Mengganti APP_DEBUG=true di
# dasboard membocorkan setiap exception ke publik.

BCRYPT_ROUNDS=12

# ══ DATABASE ════════════════════════════════════════════════════════════════
# WAJIB pgsql. Container tidak punya database.sqlite karena .dockerignore
# mengecualikannya, sehingga DB_CONNECTION=sqlite berakhir sebagai file lokal
# yang tidak ada di sana.
#
# Gunakan connection string POOLER, bukan koneksi langsung: yang langsung
# IPv6-only di Supabase, dan itu penyebab paling umum kegagalan total.
#
# WAJIB sslmode=require. Default di config/database.php adalah prefer, yang
# jatuh kembali ke plaintext, dan Supabase mewajibkan TLS.
#
# JANGAN menambahkan parameter options=. Dokumentasi Supabase menyarankan
# options=-c statement_cache_size=0 untuk pooler mode-transaksi; mengikuti saran
# itu merusak Laravel. Parameter itu ditimpa apa adanya ke config koneksi,
# PDO::ATTR_EMULATE_PREPARES yang sudah berupa array berubah jadi string, dan
# setiap query gagal dengan:
#   array_diff_key(): Argument #2 must be of type array, string given
# tests/Unit/PostgresConnectionConfigTest.php mengunci kedua sisi ini.
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.PROJECTREF:PASSWORD@POOLER-HOST:6543/postgres?sslmode=require

# ══ SESI DAN CACHE ═══════════════════════════════════════════════════════════
# WAJIB database. Dengan `array`, sesi dilupakan setiap cold start: login terlihat
# berhasil lalu langsung hilang begitu container di-restart.
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_TOKEN_EXPIRATION=1440

# Cache boleh tetap database. Tidak ada yang mengirim queued job, jadi tidak
# perlu worker dan tidak perlu Redis.
CACHE_STORE=database

# ══ BERKAS ═════════════════════════════════════════════════════════════════
FILESYSTEM_DISK=local

# ══ GAMBAR ═════════════════════════════════════════════════════════════════
# WAJIB s3. Disk lokal di dalam container hilang saat instance di-recycle: gambar
# yang diunggah hari ini tidak ada besok, dan catatan yang menunjuk ke sana
# menampilkan kotak rusak permanen.
IMAGES_DISK=s3
IMAGES_MAX_KILOBYTES=2048

# Kunci diambil dari Project Settings → Storage → S3 Configuration, dan protokol S3
# harus diaktifkan di Storage → Settings lebih dulu. Tombolnya baru muncul setelah
# protokol diaktifkan.
#
# AWS_ENDPOINT dan AWS_URL tidak boleh tertukar, dan perbedaan keduanya adalah
#symptom yang sama: kotak gambar rusak di mana-mana.
#
#   AWS_ENDPOINT  untuk UNGGAH. Supabase eksplisit meminta direct storage
#                 hostname di sini; pakai host utama proyek membuat unggahan
#                 lebih lambat.
#   AWS_URL       untuk DIBACA browser. Tanpa variabel ini Laravel mengembalikan
#                 URL endpoint API, yang butuh autentikasi — unggahan "berhasil"
#                 lalu URL-nya tersimpan ke catatan dan tidak bisa dibuka siapa
#                 pun.
#
# Cara memastikan: unggah satu gambar, lihat URL di jawabannya. Berakhiran
# /object/public/ berarti benar; berakhiran /v1/s3/ berarti AWS_URL belum
# terpakai.
#
# Bucket juga harus di-set Public di Storage → Buckets. Bucket privat menjawab
# 400 lewat /object/public/ meski URL-nya sudah benar.
AWS_ACCESS_KEY_ID=<isi-dari-supabase>
AWS_SECRET_ACCESS_KEY=<isi-dari-supabase>
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=<nama-bucket>
AWS_ENDPOINT=https://PROJECTREF.storage.supabase.co/storage/v1/s3
AWS_URL=https://PROJECTREF.supabase.co/storage/v1/object/public/<nama-bucket>
AWS_USE_PATH_STYLE_ENDPOINT=true

# ══ ASSISTANT ═══════════════════════════════════════════════════════════════
# Kunci gratis dari https://aistudio.google.com/apikey. Jangan pernah diberi
# awalan VITE_: kunci ini memb_tagih uang sungguhan setiap dipanggil. Kosong
# berarti gelembung assisten menampilkan "tidak tersedia", bukan gagal.
GEMINI_API_KEY=

# ══ LAIN-LAIN ══════════════════════════════════════════════════════════════
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Batas untuk impor dari dokumen: ukuran berkas, berapa banyak penjualan yang
# boleh dibuat dari satu berkas, dan berapa karakter yang dikirim ke model.
IMPORTS_MAX_KILOBYTES=5120
IMPORTS_MAX_ROWS=200
IMPORTS_TEXT_LIMIT=20000

# SSR butuh proses Node yang menjawab setiap request; runtime yang dibangun
# Dockerfile.vercel adalah FrankenPHP, yang tidak punya.
INERTIA_SSR_ENABLED=false