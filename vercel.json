{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "regions": ["sin1"],
    "services": {
        "app": {
            "root": ".",
            "entrypoint": "Dockerfile.vercel",
            "runtime": "container"
        }
    },
    "rewrites": [
        {
            "source": "/storage/:path*",
            "destination": "https://wmfojactydbrbgafvber.storage.supabase.co/storage/:path*"
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "app"
            }
        }
    ]
}
