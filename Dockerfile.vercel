FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_pgsql

WORKDIR /app

# Vite assets are built here rather than copied from the working tree, because
# public/build is gitignored and the welcome page's @vite directive needs a
# manifest to exist in the image. Node is not present in the runtime image, so
# this is a separate stage.
FROM node:22-bookworm-slim AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM base AS dependencies

# Composer is not part of the FrankenPHP image, so it is copied in from its own.
#
# Order matters and is not cosmetic. install runs first, from the lock file
# alone, so the dependency layer stays cached across application edits. Scripts
# are disabled there on purpose. The autoloader is generated afterwards, once
# the application has been copied, because only then is the class map complete
# enough for package discovery to boot Laravel. Reversing these two steps
# produces an authoritative autoloader containing only the application's own
# classes, and the image then fails with "Class Illuminate\Foundation\Application
# not found".
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --from=assets --chown=www-data:www-data /app/public/build /app/public/build
COPY --chown=www-data:www-data docker/Caddyfile /etc/frankenphp/Caddyfile

# The runtime binds port 80, so it needs the capability, and it runs as
# www-data, so it needs to own Caddy's own state directories or it cannot start.
RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Safe defaults only. CACHE_STORE and SESSION_DRIVER are deliberately absent:
# the spec route is throttled per client IP, and that counter has to be shared
# across instances, so it needs the database store rather than an array. Nothing
# in this API starts a session. Configuration is left uncached on purpose,
# because a cached config would freeze these values at build time, before
# Vercel injects APP_KEY and the database credentials.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    QUEUE_CONNECTION=sync

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
