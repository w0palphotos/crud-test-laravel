FROM composer:2 AS composer

FROM node:22-bookworm-slim AS assets
WORKDIR /app
COPY . .
RUN npm ci --no-audit --no-fund \
    && npm run build \
    && rm -rf node_modules

FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_pgsql opcache

WORKDIR /app

ENV APP_RUNTIME_ENV=production
ENV COMPOSER_ALLOW_SUPERUSER=1

# Composer and Node each live in their own image, because the FrankenPHP runtime
# ships neither, and neither the composer image nor the node image has the
# extensions the app needs at runtime.
#
# composer dump-autoload is used rather than install because it does not
# re-resolve the dependency graph, which keeps this layer cached across
# application edits. Scripts are disabled so autoloading is generated once, then
# post-autoload-dump is invoked explicitly: that is what writes
# bootstrap/cache/packages.php and services.php, and both must exist in the
# image rather than being regenerated per cold start.
FROM composer AS dependencies
COPY --from=composer /usr/bin/composer /usr/bin/composer
COPY . .
RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative --no-scripts \
    && composer run-script post-autoload-dump --no-dev

FROM base AS runtime

# public/build is gitignored, so it exists only because the assets stage made it.
COPY --from=assets --chown=www-data:www-data /app/public/build /app/public/build
COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data docker/Caddyfile /etc/frankenphp/Caddyfile

USER www-data

EXPOSE 8000

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
